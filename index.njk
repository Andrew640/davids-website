{#- Page template. The text, photos and recordings live in content/*.yml and are
    edited through Pages CMS (see .pages.yml). Run `npm start` to preview. -#}
{%- macro sectionImages(items) -%}
  {%- if items and items.length %}
      <div class="section-images">
        {%- for item in items %}{% if item.image %}
        <figure class="item">
          <img class="section-img" src="{{ item.image }}" alt="{{ item.caption }}" />
          {%- if item.caption %}
          <figcaption class="caption">{{ item.caption }}</figcaption>
          {%- endif %}
        </figure>
        {%- endif %}{% endfor %}
      </div>
  {%- endif %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{ settings.title }}</title>
    <meta name="Description" content="{{ settings.description }}" />
    <link rel="stylesheet" type="text/css" href="style.css" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon-16x16.png"
    />
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Mr+De+Haviland&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
    <script>
      function myFunction() {
        var x = document.getElementById("mobile");
        if (x.style.display === "flex") {
          x.style.display = "none";
        } else {
          x.style.display = "flex";
        }
      }
    </script>
  </head>

  <body>
    <div class="header">
      <a href="#top" class="davidthomas">David Thomas</a>
      <ul class="web">
        <li><a href="#Biography">Biography</a></li>
        <li><a href="#Recitals">Future recitals</a></li>
        <li><a href="#Recordings">Recordings</a></li>
        <li><a href="#Photos">Photos</a></li>
        <li><a href="#Teaching">Music Tuition</a></li>
        <li class="button-purple">
          <a href="#Contact">Contact</a>
        </li>
      </ul>
      <a href="javascript:void(0);" class="icon" onclick="myFunction()">
        <i class="icon fa fa-bars"></i>
      </a>
      <div id="mobile">
        <ul class="mobile-menu">
          <li class="mobile-menu-pad">
            <a href="#Biography" onclick="myFunction()">Biography</a>
          </li>
          <li class="mobile-menu-pad">
            <a href="#Recitals" onclick="myFunction()">Future recitals</a>
          </li>
          <li class="mobile-menu-pad">
            <a href="#Recordings" onclick="myFunction()">Recordings</a>
          </li>
          <li class="mobile-menu-pad">
            <a href="#Photos" onclick="myFunction()">Photos</a>
          </li>
          <li class="mobile-menu-pad">
            <a href="#Teaching" onclick="myFunction()">Music Tuition</a>
          </li>
          <li class="mobile-menu-pad" onclick="myFunction()">
            <a href="#Contact">Contact</a>
          </li>
        </ul>
      </div>
    </div>

    <div id="top" class="background">
      {%- if home.image %}
      <img class="main-img" src="{{ home.image }}" alt="David Thomas" loading="eager" />
      {%- endif %}
      <div class="main-des">
        <div class="info">{{ home.heading | escape | nl2br | safe }}</div>
        <div class="quals">{{ home.qualifications }}</div>
      </div>
    </div>

    <div id="Biography" class="sec-bio sec-w">
      <div class="sec-title Biography">Biography</div>
      <div class="text rich Biography-text">{{ biography.body | safe }}</div>
      {{ sectionImages(biography.images) }}
    </div>

    <div id="Recitals" class="sec-small sec-g">
      <div class="arrow-white"></div>
      <div class="sec-title">Future recitals</div>
      <div class="text rich line-height">{{ recitals.body | safe }}</div>
      {{ sectionImages(recitals.images) }}
    </div>

    <div id="Recordings" class="sec sec-w recordings">
      <div class="arrow-grey"></div>
      <div class="sec-title">Recordings</div>
      {%- for group in recordings.groups %}
      <div class="sec-subtitle">{{ group.heading }}</div>
      <div class="text">
        {%- for track in group.tracks %}{% if track.file %}
        <div class="track">
          <div class="track-title">{{ track.title }}</div>
          <audio class="audio" controls preload="metadata">
            <source src="{{ track.file | encodeURI }}" type="audio/mpeg" />
            Your browser does not support the audio element.
          </audio>
        </div>
        {%- endif %}{% endfor %}
      </div>
      {%- endfor %}
    </div>

    <div id="Photos" class="sec-photos sec-g">
      <div class="arrow-white"></div>
      <div class="sec-title">Photos</div>
      <div class="bio-images">
        {%- for photo in photos.photos %}{% if photo.image %}
        <figure class="item">
          <img class="g-img" src="{{ photo.image }}" alt="{{ photo.caption }}" />
          {%- if photo.caption %}
          <figcaption class="caption">{{ photo.caption }}</figcaption>
          {%- endif %}
        </figure>
        {%- endif %}{% endfor %}
      </div>
    </div>

    <div id="Teaching" class="sec-small sec-w">
      <div class="arrow-grey"></div>
      <div class="sec-title">Music Tuition</div>
      <div class="text rich">{{ tuition.body | safe }}</div>
      {{ sectionImages(tuition.images) }}
      <div class="text text-plus">A member of:</div>
      <div class="flex-line">
        <span class="ISM"></span>
        <span class="RCO"></span>
      </div>
    </div>

    <div id="Contact" class="sec Contact-sec sec-g text">
      <div class="arrow-white"></div>
      <div class="sec-title">Contact</div>
      <div class="text rich">{{ contact.body | safe }}</div>
      <br />
      <form
        action="https://formspree.io/davidthomas096@gmail.com"
        method="POST"
      >
        <span class="label">Name</span
        ><input class="form" type="text" name="name" /><br /><br />
        <span class="label">Email</span
        ><input class="form" type="email" name="_replyto" /><br /><br />
        <span class="label">Message</span
        ><textarea class="form message" type="text" name="message"></textarea
        ><br /><br />
        <input class="submit" type="submit" value="Send" />
        <input
          type="hidden"
          name="_next"
          value="http://davidthomasorganist.co.uk/#Contact"
        />
        <input type="hidden" name="_subject" value="Website message" />
        <input type="text" name="_gotcha" style="display: none" />
        <input type="text" name="_format" value="plain" style="display: none" />
      </form>
      <br />
      <a
        class="social fb"
        href="https://www.facebook.com/profile.php?id=1342925540"
      ></a>
      <a
        class="social ins"
        href="https://www.instagram.com/david.thomas096/"
      ></a>
    </div>

    <script>
      // Links added in the editor to other websites open in a new tab.
      document.querySelectorAll(".rich a[href^='http']").forEach(function (a) {
        if (a.hostname !== location.hostname) a.target = "_blank";
      });
    </script>
  </body>

  <script>
    (function (i, s, o, g, r, a, m) {
      i["GoogleAnalyticsObject"] = r;
      (i[r] =
        i[r] ||
        function () {
          (i[r].q = i[r].q || []).push(arguments);
        }),
        (i[r].l = 1 * new Date());
      (a = s.createElement(o)), (m = s.getElementsByTagName(o)[0]);
      a.async = 1;
      a.src = g;
      m.parentNode.insertBefore(a, m);
    })(
      window,
      document,
      "script",
      "https://www.google-analytics.com/analytics.js",
      "ga"
    );

    ga("create", "UA-105800976-1", "auto");
    ga("send", "pageview");
  </script>
</html>
